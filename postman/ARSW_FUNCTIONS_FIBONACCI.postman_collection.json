{
	"info": {
		"name": "ARSW_FUNCTIONS_FIBONACCI",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "fibonacci",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Respuesta con el numero completo\", function () {",
							"    pm.expect(pm.response.text().length).to.be.above(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nth\": {{nth}}\n}"
				},
				"url": {
					"raw": "https://{{host}}/api/Fibonacci",
					"protocol": "https",
					"host": [
						"{{host}}"
					],
					"path": [
						"api",
						"Fibonacci"
					]
				}
			},
			"response": []
		}
	]
}
